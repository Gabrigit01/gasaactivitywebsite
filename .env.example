HOST=127.0.0.1
PORT=3000
# NODE_ENV=production
# PUBLIC_URL=https://activites.exemple.bj
# PostgreSQL / Neon : renseigner la chaîne de connexion complète avec SSL.
# Sans DATABASE_URL, les essais locaux utilisent SQLite dans DATA_DIR.
DATABASE_URL=
# DATA_DIR=./data
# TRUST_PROXY=1

# Render : choisir Web Service / Node, NODE_VERSION=24, NODE_ENV=production,
# HOST=0.0.0.0 et TRUST_PROXY=1. Laisser Render fournir PORT.
# L’adresse HTTPS Render est détectée automatiquement via RENDER_EXTERNAL_URL.
# Avec Neon, DATA_DIR et un disque persistant Render ne sont pas nécessaires.

ADMIN_OWNER_USERNAME=
ADMIN_OWNER_PASSWORD=
ADMIN_ORGANIZER_USERNAME=
ADMIN_ORGANIZER_PASSWORD=
ADMIN_VIEWER_USERNAME=
ADMIN_VIEWER_PASSWORD=

# Essai local avec un seul accès, si les comptes ci-dessus sont vides.
ADMIN_PASSWORD=

# Optionnel pour limiter l’ouverture de nouveaux comptes étudiants.
STUDENT_SIGNUP_CODE=

# Notifications navigateur. Générer les clés avec npx web-push generate-vapid-keys.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
